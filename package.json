{
	"name": "blumberg",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"    LINTING AND FORMATTING    ": "",
		"format": "biome check --write",
		"format:check": "biome check",
		"    I18N    ": "",
		"i18n:extract": "lingui extract",
		"i18n:watch": "bun run i18n:extract --overwrite --watch --debounce 500",
		"i18n:compile": "lingui compile --typescript",
		"i18n:messages:extract": "bun run i18n:extract && bun scripts/i18n.ts extract",
		"i18n:messages:replace": "bun run i18n:extract && bun scripts/i18n.ts replace",
		"i18n:messages:clean": "bun run i18n:extract && bun scripts/i18n.ts clean",
		"i18n:messages:translate": "bun scripts/i18n.ts translate",
		"    AUTHORIZATION    ": "",
		"authorization:generate": "bun scripts/authorization-generator.ts",
		"    API    ": "",
		"openapi:gen": "bunx openapi-ts --file ./packages/api/openapi.config.ts",
		"format:openapi": "biome check --write ./packages/api/generated",
		"api:scripts": "bun scripts/hey-api.ts",
		"api:gen": "bun run openapi:gen && bun run api:scripts && bun run format:openapi",
		"    APP    ": "",
		"app:build": "bun scripts/app.ts build",
		"app:start": "bun scripts/app.ts start",
		"app:typecheck": "react-router typegen ./apps/app --config ./apps/app/vite.config.ts && tsgo",
		"    SKILLS    ": "",
		"skills:claude": "mkdir -p .claude && ln -sfn ../.llm/skills .claude/skills",
		"skills:gemini": "mkdir -p .gemini && ln -sfn ../.llm/skills .gemini/skills",
		"build": "node_modules/.bin/react-router build ./apps/app --config ./apps/app/vite.config.ts"
	},
	"engines": {
		"node": "please-use-bun",
		"bun": ">=1.3.8",
		"npm": "please-use-bun",
		"pnpm": "please-use-bun",
		"yarn": "please-use-bun"
	},
	"packageManager": "bun@1.3.8",
	"trustedDependencies": ["esbuild"],
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": ["eslint --fix", "biome check --write"],
		"*.{json,jsonc,css}": ["biome check --write"]
	},
	"dependencies": {
		"@casl/ability": "^6.8.0",
		"@casl/react": "^5.0.1",
		"@hookform/resolvers": "^5.2.2",
		"@lingui/core": "^5.8.0",
		"@lingui/message-utils": "^5.8.0",
		"@lingui/react": "^5.8.0",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.8",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@react-router/fs-routes": "^7.12.0",
		"@react-router/node": "7.12.0",
		"@react-router/serve": "7.12.0",
		"@tanstack/query-core": "^5.90.19",
		"@tanstack/react-query": "^5.90.19",
		"@tanstack/react-table": "^8.21.3",
		"axios": "^1.13.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"crypto-js": "^4.2.0",
		"decimal.js": "^10.6.0",
		"isbot": "^5.1.31",
		"leaflet": "^1.9.4",
		"lucide-react": "^0.563.0",
		"react-leaflet": "^4.2.1",
		"mobx": "^6.15.0",
		"mobx-react-lite": "^4.1.1",
		"qs": "^6.14.1",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-hook-form": "^7.71.1",
		"react-router": "7.12.0",
		"recharts": "^3.7.0",
		"rxjs": "^7.8.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"tslib": "^2.8.1",
		"vaul": "^1.1.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@aws-sdk/client-translate": "^3.984.0",
		"@babel/preset-react": "^7.28.5",
		"@babel/preset-typescript": "^7.28.5",
		"@biomejs/biome": "2.3.11",
		"@eslint/js": "^9.39.2",
		"@hey-api/openapi-ts": "^0.91.0",
		"@lingui/babel-plugin-lingui-macro": "^5.8.0",
		"@lingui/cli": "^5.8.0",
		"@lingui/conf": "^5.8.0",
		"@lingui/format-json": "^5.8.0",
		"@lingui/vite-plugin": "^5.8.0",
		"@react-router/dev": "7.12.0",
		"@react-router/remix-routes-option-adapter": "7.12.0",
		"@tailwindcss/vite": "^4.1.13",
		"@types/crypto-js": "^4.2.2",
		"@types/bun": "^1.3.8",
		"@types/leaflet": "^1.9.8",
		"@types/node": "^22",
		"@types/qs": "^6.14.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "latest",
		"concurrently": "^9.2.1",
		"eslint": "9.39.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"husky": "^9.1.7",
		"lint-staged": "16.2.7",
		"remix-flat-routes": "^0.8.5",
		"tailwindcss": "^4.1.13",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.1.7",
		"vite-plugin-babel": "^1.4.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-tsconfig-paths": "^5.1.4"
	}
}
